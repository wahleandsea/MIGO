# ============ 数据库连接（二选一） ============
# 配了 MONGO_URI 就用 MongoDB Atlas；没配 MONGO_URI 但配了 DATABASE_URL 就用 PostgreSQL；
# 都没配则自动使用“本机演示模式”（双击 index.html 也能用，数据存在浏览器 localStorage）。

# --- 方式一：MongoDB Atlas（推荐）---
# 在 MongoDB Atlas 创建免费集群（M0），Database Access 建一个带读写的用户，
# 然后复制连接串，格式如：
# mongodb+srv://用户名:密码@migo.ryeynab.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=REPLACE_WITH_MONGO_URI
# 可选：指定数据库名（默认 milano_ride）
MONGO_DB=milano_ride

# --- 方式二：Aiven PostgreSQL（旧）---
# DATABASE_URL=postgres://用户名:密码@主机:端口/数据库名?sslmode=require
# PG_SSL_CA_PATH=ca.pem   # Aiven 可选：CA 证书路径（放在项目根目录）
# PG_SSL_REJECT_UNAUTHORIZED=false

# ============ 服务器 ============
PORT=5173
# 手机在同一 Wi-Fi 测试时改为 0.0.0.0
# HOST=0.0.0.0

# 后台审核台 API 密钥（admin-miniapp 里“本机演示版”不需要；远程数据库模式需要）
ADMIN_KEY=demo-admin

# 开发用：司机注册后自动通过审核（不用再走后台）
# DRIVER_AUTO_APPROVE=true
